{
  "expo": {
    "name": "Zombie Deck",
    "slug": "zombie-deck",
    "scheme": "zombiedeck",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/a8178b20-e29e-47f4-9bc3-579cc1c0d1c4"
    },
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.navis62.zombiedeck",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "CFBundleLocalizations": ["en", "fr", "de", "es", "it", "pl", "pt-BR", "ru"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.navis62.zombiedeck",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.navis62.zombiedeck",
      "adaptiveIcon": {
        "backgroundColor": "#14130f",
        "foregroundImage": "./assets/zombie-icon-foreground.png",
        "monochromeImage": "./assets/zombie-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14130f",
          "image": "./assets/cards/back.jpg",
          "imageWidth": 200
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "a8178b20-e29e-47f4-9bc3-579cc1c0d1c4"
      }
    },
    "owner": "navis62"
  }
}
